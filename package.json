{
    "name": "nextai-translator-firefox",
    "version": "0.6.43",
    "private": true,
    "description": "Independent Firefox-only fork of NextAI Translator with custom OpenAI-compatible API support",
    "author": "Rez1ce",
    "repository": {
        "type": "git",
        "url": "https://github.com/Rez1ce/nextai-translator-firefox.git"
    },
    "homepage": "https://github.com/Rez1ce/nextai-translator-firefox#readme",
    "bugs": {
        "url": "https://github.com/Rez1ce/nextai-translator-firefox/issues"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "packageManager": "pnpm@9.1.3",
    "scripts": {
        "dev": "NODE_ENV=development vite build --watch",
        "build": "tsc --noEmit && vite build",
        "package": "npm run build && rm -f dist/nextai-translator-firefox.zip && cd dist/firefox && zip -Xqr ../nextai-translator-firefox.zip .",
        "package:source": "mkdir -p dist && git archive --format=zip --output=dist/nextai-translator-firefox-source.zip HEAD",
        "package:amo": "npm run package && npm run package:source",
        "test": "vitest run --config vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.{ts,tsx}\" --cache",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\" --cache",
        "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md,json}\""
    },
    "license": "AGPL-3.0",
    "dependencies": {
        "@floating-ui/dom": "^1.5.1",
        "baseui-sd": "^12.2.4",
        "best-effort-json-parser": "^1.0.1",
        "clsx": "^1.2.1",
        "color": "^4.2.3",
        "common-tags": "^1.8.2",
        "date-fns": "^2.29.3",
        "dayjs": "^1.11.10",
        "dexie": "^3.2.3",
        "dexie-react-hooks": "^1.1.3",
        "edge-tts-universal": "^1.4.0",
        "eventsource-parser": "^1.0.0",
        "hotkeys-js": "^3.10.1",
        "i18next": "^23.4.4",
        "i18next-browser-languagedetector": "^7.1.0",
        "i18next-http-backend": "^2.2.1",
        "iso-639-1": "^3.0.1",
        "jotai": "^2.8.0",
        "js-sha3": "^0.9.3",
        "js-tiktoken": "^1.0.10",
        "jss": "^10.10.0",
        "jss-preset-default": "^10.10.0",
        "katex": "^0.16.8",
        "lodash.debounce": "^4.0.8",
        "lru-cache": "^10.0.1",
        "prism-react-renderer": "^2.3.0",
        "qs": "^6.11.2",
        "rc-field-form": "^1.36.0",
        "react": "^18.2.0",
        "react-code-block": "^1.0.0",
        "react-copy-to-clipboard": "^5.1.0",
        "react-dom": "^18.2.0",
        "react-draggable": "^4.4.5",
        "react-dropzone": "^14.2.3",
        "react-error-boundary": "^4.0.10",
        "react-hooks-global-state": "^2.1.0",
        "react-hot-toast": "^2.4.1",
        "react-hotkeys-hook": "^4.4.1",
        "react-i18next": "^13.0.3",
        "react-icons": "^5.0.1",
        "react-jss": "^10.10.0",
        "react-latex-next": "^2.2.0",
        "react-markdown": "^8.0.7",
        "react-use": "^17.4.2",
        "react-window": "^1.8.9",
        "remark-gfm": "^3.0.1",
        "styletron-engine-atomic": "^1.5.0",
        "styletron-react": "^6.1.0",
        "swr": "^2.2.0",
        "tesseract.js": "^4.0.2",
        "underscore": "^1.13.6",
        "url-join-ts": "^1.0.5",
        "use-deep-compare": "^1.1.0",
        "use-resize-observer": "^9.1.0",
        "uuid": "^9.0.0",
        "web-streams-polyfill": "^3.2.1",
        "webextension-polyfill": "^0.10.0",
        "zustand": "^4.4.0"
    },
    "devDependencies": {
        "@samrum/vite-plugin-web-extension": "^5.0.0",
        "@types/chrome": "0.0.242",
        "@types/color": "^3.0.6",
        "@types/common-tags": "^1.8.3",
        "@types/lodash.debounce": "^4.0.7",
        "@types/node": "^20.5.9",
        "@types/qs": "^6.9.10",
        "@types/react": "^18.2.18",
        "@types/react-copy-to-clipboard": "^5.0.4",
        "@types/react-dom": "^18.2.7",
        "@types/react-window": "^1.8.5",
        "@types/underscore": "^1.11.6",
        "@types/uuid": "^9.0.2",
        "@types/webextension-polyfill": "^0.10.1",
        "@typescript-eslint/eslint-plugin": "^6.2.1",
        "@typescript-eslint/parser": "^6.6.0",
        "@vitejs/plugin-react": "^4.0.4",
        "eslint": "^8.46.0",
        "eslint-config-prettier": "^8.9.0",
        "eslint-import-resolver-typescript": "^3.5.5",
        "eslint-plugin-baseui": "^13.0.0",
        "eslint-plugin-import": "^2.28.0",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-react": "^7.33.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jsdom": "^22.1.0",
        "prettier": "^3.0.0",
        "typescript": "^5.1.6",
        "vite": "^4.3.9",
        "vite-plugin-svgr": "^4.2.0",
        "vite-tsconfig-paths": "^4.2.0",
        "vitest": "^0.34.3"
    }
}
